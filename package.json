{
  "name": "tourgirls",
  "private": true,
  "version": "1.0.0",
  "description": "TourGirls: API de atracciones (NestJS + PostgreSQL), servicio de autenticaciÃ³n y portal web.",
  "workspaces": [
    "packages/domain",
    "packages/data-management",
    "packages/business",
    "packages/contracts",
    "packages/data-access",
    "packages/platform",
    "apps/api",
    "apps/auth",
    "apps/services/identity",
    "apps/services/ms-identity",
    "apps/services/ms-catalog",
    "apps/services/ms-inventory",
    "apps/services/ms-payment",
    "apps/services/ms-order",
    "apps/services/ms-booking",
    "apps/services/ms-invoicing",
    "apps/services/catalog",
    "apps/services/inventory",
    "apps/services/cart",
    "apps/services/ms-cart",
    "apps/services/ms-coupon",
    "apps/services/ms-pricing",
    "apps/services/ms-location",
    "apps/services/ms-billing-profile",
    "apps/services/ms-review",
    "apps/services/ms-refund",
    "apps/services/ms-support",
    "apps/services/order",
    "apps/services/booking",
    "apps/services/payment",
    "apps/services/invoicing",
    "apps/services/audit",
    "apps/booking-mock",
    "apps/esb",
    "apps/partner-api",
    "apps/gateway",
    "apps/graphql",
    "apps/sri-mock"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:db": "jest --selectProjects db --runInBand",
    "db:local": "node tools/local-db.mjs",
    "db:migrate": "node tools/migrate-services.mjs",
    "contract:lint": "npx -y @stoplight/spectral-cli@6.17.0 lint packages/contracts/openapi/atracciones-openapi-v2.yaml --ruleset packages/contracts/.spectral.yaml --fail-severity error",
    "contract:mock": "npx -y @stoplight/prism-cli@5.16.0 mock packages/contracts/openapi/atracciones-openapi-v2.yaml --port 4010",
    "contract:types": "openapi-typescript packages/contracts/openapi/atracciones-openapi-v2.yaml -o packages/contracts/src/generated/atracciones-v2.ts",
    "start:booking-mock": "node apps/booking-mock/dist/main.js",
    "migration:generate": "npm run build && typeorm migration:generate -d packages/data-access/dist/data-source.js",
    "start:api": "node apps/api/dist/main.js",
    "start:auth": "node apps/auth/dist/main.js",
    "lint": "tsc -b tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.25.12",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "typescript": "~5.8.3"
  }
}
